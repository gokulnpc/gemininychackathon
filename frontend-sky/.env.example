# ═══════════════════════════════════════════════════════════════════════════════
# Story Factory — Frontend Environment Variables
#
# When running via docker compose, these are passed as build args automatically
# (defaults point to the hackathon Firebase project — no setup needed).
#
# For local dev (pnpm dev), copy to .env.local and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API URL — for local dev this is the FastAPI server
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase project config (browser-side public keys — safe to share)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
