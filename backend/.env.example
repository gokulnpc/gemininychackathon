# Copy to .env and fill in your values
# cp .env.example .env

# ── Gemini / Google AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Google Cloud ───────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_BUCKET=voicevid-assets

# ── Vertex AI (set true when deploying to Cloud Run) ───────────────────────
USE_VERTEX_AI=false
VERTEX_AI_LOCATION=us-central1

# ── YouTube OAuth (optional — only needed for publish endpoint) ────────────
# YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
