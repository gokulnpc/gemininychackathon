# ═══════════════════════════════════════════════════════════════════════════════
# Story Factory — Backend Environment Variables
# Copy this file to .env and fill in the required values.
# ═══════════════════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Google Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# GCP project ID — used for Firestore, GCS, and optionally Vertex AI
GOOGLE_CLOUD_PROJECT=

# GCS bucket for storing generated videos and assets
GCS_BUCKET=storylab-assets

# ── GCP CREDENTIALS (choose one option) ──────────────────────────────────────
#
# Option A — gcloud CLI (recommended for local dev):
#   Run:  gcloud auth application-default login
#   Then in docker-compose.yml uncomment the gcloud volume mount.
#   No env var needed — ADC is picked up automatically.
#
# Option B — service account key file:
#   Download a key JSON from GCP Console → IAM → Service Accounts
#   Place it at ./credentials.json (gitignored) and uncomment both lines below:
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
#   Also uncomment the credentials.json volume in docker-compose.yml.

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Leave empty locally — pipeline runs synchronously without Cloud Tasks
WORKER_URL=

# Timeline renderer (set automatically by docker-compose; leave empty to use CLI fallback)
TIMELINE_RENDER_WORKER_URL=

# Public base URLs (used to normalize media srcs in timeline JSON)
FRONTEND_PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8000

# Set to true to use Vertex AI instead of Gemini API (requires USE_VERTEX_AI=true)
USE_VERTEX_AI=false

# SendGrid — email notifications (optional)
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=noreply@voicevid.app

# YouTube OAuth (optional — only needed for YouTube publishing)
# YOUTUBE_CLIENT_SECRETS_FILE=/app/client_secrets.json

# Instagram (optional)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# TikTok (optional)
# TIKTOK_ACCESS_TOKEN=

# Google Document AI (optional — leave empty to use Gemini for PDF OCR)
# DOCUMENT_AI_PROCESSOR_ID=
# DOCUMENT_AI_LOCATION=us

# Debug mode
DEBUG=false
